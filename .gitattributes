# Auto-detect text files and normalize line endings
* text=auto

# Force Unix line endings for shell scripts (must work on Linux/macOS)
gradlew text eol=lf
*.sh text eol=lf

# Force Windows line endings for batch files
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Java source files — normalize to LF
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files — do not touch
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ttf binary
*.wav binary
*.ogg binary
